OLLAMA_BASE_URL=http://localhost:11434

# ─── RAG PIPELINE MODELS ─────────────────────────────────────────────────────
EMBED_MODEL=snowflake-arctic-embed2:latest
RERANK_MODEL=qllama/bge-reranker-v2-m3:f16

# ─── JUDGE MODEL (used for claim extraction, stance detection, explanations) ─
JUDGE_MODEL=llama3.1:8b

# ─── DEFAULT CHAT MODEL ──────────────────────────────────────────────────────
DEFAULT_CHAT_MODEL=llama3.1:8b

# ─── AVAILABLE CHAT MODELS (comma-separated) ─────────────────────────────────
AVAILABLE_MODELS=vicuna:13b

# ─── RAG PIPELINE SETTINGS ───────────────────────────────────────────────────
TOP_K_RETRIEVE=15
TOP_K_RERANK=5
MAX_CONTEXT_TOKENS=8000

# ─── BACKEND SETTINGS ────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# ─── VECTOR DB ───────────────────────────────────────────────────────────────
# Options: faiss, chroma
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./data/vector_store

# ─── WEB SEARCH ──────────────────────────────────────────────────────────────
SELENIUM_HEADLESS=true
SELENIUM_ENABLED=true

# ─── FACT-CHECK DOMAINS ──────────────────────────────────────────────────────
# Tier 1: IFCN-certified Indian fact-checkers (weight 1.0)
TIER1_FACT_CHECK_DOMAINS=altnews.in,boomlive.in,factly.in,vishvasnews.com,pib.gov.in,thequint.com/news/webqoof,newschecker.in,smythi.in,factchecker.in,newsmobile.in,thelogicalindian.com
TIER1_WEIGHT=1.0

# Tier 2: International fact-checkers (weight 0.85)
TIER2_FACT_CHECK_DOMAINS=snopes.com,politifact.com,reuters.com/fact-check,factcheck.org,fullfact.org,apnews.com/hub/ap-fact-check,bbc.com/news/reality_check,logicallyfacts.com,polygraph.info,afp.com,leadstories.com,check4spam.com,africacheck.org
TIER2_WEIGHT=0.85

# Tier 3: Gold-standard mainstream news (weight 0.6)
TIER3_NEWS_DOMAINS=thehindu.com,indianexpress.com,ndtv.com,ptinews.com,hindustantimes.com,livemint.com,timesofindia.indiatimes.com,thewire.in,scroll.in,newslaundry.com,economictimes.indiatimes.com,bbc.com,reuters.com,aljazeera.com,theguardian.com,cnn.com,apnews.com,france24.com,dw.com,washingtonpost.com,nytimes.com,espncricinfo.com,cricbuzz.com
TIER3_WEIGHT=0.6

# ─── FACT-CHECK PIPELINE SETTINGS ────────────────────────────────────────────
FACT_CHECK_RESULTS_PER_TIER=5
VERDICT_FAKE_THRESHOLD=-0.3
VERDICT_TRUE_THRESHOLD=0.3
MIN_EVIDENCE_COUNT=2

# ─── APP SETTINGS ────────────────────────────────────────────────────────────
APP_NAME=NexusAI
LOG_LEVEL=INFO