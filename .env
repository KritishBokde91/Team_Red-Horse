OLLAMA_BASE_URL=http://localhost:11434

# ─── RAG PIPELINE MODELS ─────────────────────────────────────────────────────
EMBED_MODEL=snowflake-arctic-embed2:latest
RERANK_MODEL=qllama/bge-reranker-v2-m3:f16

# ─── DEFAULT CHAT MODEL ──────────────────────────────────────────────────────
DEFAULT_CHAT_MODEL=deepseek-r1:14b

# ─── AVAILABLE CHAT MODELS (comma-separated) ─────────────────────────────────
AVAILABLE_MODELS=vicuna:13b

# ─── RAG PIPELINE SETTINGS ───────────────────────────────────────────────────
TOP_K_RETRIEVE=15
TOP_K_RERANK=5
MAX_CONTEXT_TOKENS=8000

# ─── BACKEND SETTINGS ────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# ─── VECTOR DB ───────────────────────────────────────────────────────────────
# Options: faiss, chroma
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./data/vector_store

# ─── WEB SEARCH ──────────────────────────────────────────────────────────────
# Selenium browser for JS-heavy pages (fallback when httpx+trafilatura fails)
# true = hidden browser (background), false = visible browser (watch scraping)
SELENIUM_HEADLESS=true
# Enable/disable Selenium fallback entirely
SELENIUM_ENABLED=true

# ─── APP SETTINGS ────────────────────────────────────────────────────────────
APP_NAME=NexusAI
LOG_LEVEL=INFO