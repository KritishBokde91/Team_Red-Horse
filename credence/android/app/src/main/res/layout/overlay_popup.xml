<?xml version="1.0" encoding="utf-8"?>
<!-- overlay_popup.xml — Neo-brutalism floating verdict card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="12dp">

    <!-- Main card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="8dp">

        <!-- Top bar: indicator + verdict + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Color indicator bar -->
            <View
                android:id="@+id/v_indicator"
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="#1C1917" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- App label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CREDENCE SHIELD"
                    android:textSize="10sp"
                    android:textColor="#78716C"
                    android:letterSpacing="0.15"
                    android:fontFamily="sans-serif-medium" />

                <!-- Verdict -->
                <TextView
                    android:id="@+id/tv_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHECKING"
                    android:textSize="22sp"
                    android:textColor="#1C1917"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Score badge -->
            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#1C1917"
                android:fontFamily="sans-serif-medium"
                android:paddingEnd="8dp" />

            <!-- Close button -->
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close"
                android:padding="4dp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#E7E5E4"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Claim text -->
        <TextView
            android:id="@+id/tv_claim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking claim..."
            android:textSize="13sp"
            android:textColor="#1C1917"
            android:fontFamily="sans-serif"
            android:textStyle="italic"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Explanation -->
        <TextView
            android:id="@+id/tv_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyzing sources..."
            android:textSize="12sp"
            android:textColor="#78716C"
            android:fontFamily="sans-serif"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
